{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jervis-experimental-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-29",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }
  ]
}
